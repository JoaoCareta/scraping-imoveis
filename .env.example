PORT=3000
HOST=0.0.0.0
CLIENTE_ID=innove
ORIGIN=https://imobiliariainnove.com.br
# Plataforma da fonte: moldsystems (default, API Solr) | kenlo (scraping HTML)
PLATAFORMA=moldsystems
# Estratégia do Kenlo: html (default) | api (futuro, API oficial)
ESTRATEGIA=html
# SOLR_NUM_ROWS só se aplica a PLATAFORMA=moldsystems.
SOLR_NUM_ROWS=5000
FETCH_TIMEOUT_MS=8000
LOG_LEVEL=info
#
# Exemplo de instância para o cliente caires (plataforma Kenlo):
#   CLIENTE_ID=caires
#   ORIGIN=https://www.cairesengimob.com.br
#   PLATAFORMA=kenlo
#   ESTRATEGIA=html
# (o guard ?cliente= no scraper-api garante que a instância só atende esse cliente)
# Vazio = sem autenticação (rede interna/VPN). Preencher ativa o header x-api-key.
API_KEY=
